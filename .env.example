# Exact public origin plus /a2a/; set after creating the Render service.
A2A_BASE_URL=https://YOUR-SERVICE.onrender.com/a2a/
# Comma-separated accepted tokens. Each token is an isolated principal.
A2A_BEARER_TOKENS=replace-with-a-long-random-token
# Groq or another OpenAI-compatible endpoint. Never commit real secrets.
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Render injects DATABASE_URL from the attached PostgreSQL database.
